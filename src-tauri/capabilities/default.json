{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AirLab main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/*" },
        { "path": "$HOME/**/*" }
      ]
    }
  ]
}
